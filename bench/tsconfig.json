{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": [
    "types/generated/**",
    "types/results/**",
    "runtime/results/**",
    "http/results/**",
    "http/generated/**"
  ]
}
