{
  "name": "gelis",
  "version": "0.0.0",
  "description": "A lightweight, inference-first TypeScript backend framework designed for runtime speed and TypeScript scalability.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gelisjs/gelis.git"
  },
  "bugs": {
    "url": "https://github.com/gelisjs/gelis/issues"
  },
  "homepage": "https://github.com/gelisjs/gelis#readme",
  "scripts": {
    "check": "bun run typecheck && bun run typecheck:bench && bun run test:types && bun run typecheck:runtime-tests && bun run typecheck:bun-adapter && bun run test:runtime",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:bench": "tsc -p bench/tsconfig.json --noEmit",
    "test:types": "tsc -p test/types/tsconfig.json --noEmit",
    "typecheck:runtime-tests": "tsc -p test/runtime/tsconfig.json --noEmit",
    "test:runtime": "bun test test/runtime",
    "bench:types:generate": "bun bench/types/generate.mts",
    "bench:types:quick": "bun bench/types/run.mts --runs=1 --sizes=100,500",
    "bench:types": "bun bench/types/run.mts",
    "bench:runtime:quick": "bun bench/runtime/run.mts --quick",
    "bench:runtime": "bun bench/runtime/run.mts",
    "bench:runtime:components": "bun bench/runtime/components.mts",
    "bench:runtime:router": "bun bench/runtime/router-components.mts",
    "bench:runtime:lifecycle": "bun bench/runtime/lifecycle.mts",
    "bench:http:autocannon": "bun bench/http/run.mts",
    "bench:http": "bun bench/http/run-oha.mts",
    "bench:http:elysia2:aot:build": "bun run --cwd bench/http/elysia-v2-aot build",
    "typecheck:bun-adapter": "tsc -p prototype/bun/tsconfig.json --noEmit",
    "bench:http:adapter": "bun bench/http/run-gelis-adapter.mts",
    "bench:http:validation": "bun bench/http/validation/run.mts",
    "bench:http:lifecycle": "bun bench/http/lifecycle/run.mts",
    "bench:runtime:lifecycle:global": "bun bench/runtime/global-lifecycle.mts",
    "bench:http:lifecycle:global": "bun bench/http/global-lifecycle/run.mts",
    "bench:runtime:on-request": "bun bench/runtime/on-request.mts",
    "bench:runtime:on-request:isolated": "bun bench/runtime/on-request-isolated.mts",
    "bench:http:on-request": "bun bench/http/on-request/run.mts",
    "bench:runtime:on-error": "bun bench/runtime/on-error.mts",
    "bench:runtime:on-error:isolated": "bun bench/runtime/on-error-isolated.mts",
    "bench:http:on-error": "bun bench/http/on-error/run.mts",
    "bench:runtime:response:zero-unused": "bun bench/runtime/response-zero-unused.mts",
    "bench:runtime:response": "bun bench/runtime/response-contracts.mts",
    "bench:http:response": "bun bench/http/response/run.mts",
    "bench:http:response:compare": "bun bench/http/response-comparison/run.mts",
    "bench:runtime:contract:zero-unused": "bun bench/runtime/contract-zero-unused.mts",
    "bench:runtime:contract:inspect": "bun bench/runtime/contract-inspection.mts",
    "bench:runtime:decomposition": "bun bench/runtime/decomposition.mts",
    "bench:runtime:executor-specialization": "bun bench/runtime/executor-specialization.mts",
    "bench:runtime:params": "bun bench/runtime/params-materialization.mts",
    "bench:http:bun-native-routing": "bun bench/http/bun-native-routing/run.mts"
  },
  "devDependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.4.0",
    "autocannon": "^8.0.0",
    "elysia": "^1.4.30",
    "elysia-v2": "npm:elysia@2.0.0-beta.11",
    "hono": "^4.13.5",
    "typescript": "7.0.2"
  }
}
